<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- HEADER CARD -->

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#F9FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <!-- TITLE -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AQI Levels"
                    android:textColor="#222222"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="User can see AQI levels"
                    android:textColor="#777777"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="20dp"
        android:background="@color/white">
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            android:padding="8dp"
            android:background="@color/white">

            <!-- Header Row -->

            <TableRow
                android:background="#FFFFFF">

                <TextView
                    android:text="AQI"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:padding="8dp" />

                <TextView
                    android:text="Category"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:padding="8dp" />

                <TextView
                    android:text="Health Impact"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:padding="8dp" />
            </TableRow>

            <!-- Row 1 -->

            <TableRow
                android:background="#E8F5E9">

                <TextView
                    android:text="0 - 50"
                    android:padding="8dp"
                    android:textColor="#333333"/>

                <TextView
                    android:text="Good"
                    android:textColor="#67AA01"
                    android:textStyle="bold"
                    android:padding="8dp" />

                <TextView
                    android:text="No health risk"
                    android:padding="8dp"
                    android:textColor="#333333"/>
            </TableRow>

            <!-- Row 2 -->

            <TableRow
                android:background="#FFFDE7">

                <TextView
                    android:text="51 - 100"
                    android:padding="8dp"
                    android:textColor="#333333"/>

                <TextView
                    android:text="Moderate"
                    android:textColor="#FFE611"
                    android:textStyle="bold"
                    android:padding="8dp" />

                <TextView
                    android:text="Minor risk"
                    android:padding="8dp"
                    android:textColor="#333333"/>
            </TableRow>

            <!-- Row 3 -->

            <TableRow
                android:background="#FFF3E0">

                <TextView
                    android:text="101 - 150"
                    android:padding="8dp"
                    android:textColor="#333333"/>

                <TextView
                    android:text="Sensitive"
                    android:textColor="#FF9800"
                    android:textStyle="bold"
                    android:padding="8dp" />

                <TextView
                    android:text="Sensitive groups affected"
                    android:padding="8dp"
                    android:textColor="#333333"/>
            </TableRow>

            <!-- Row 4 -->

            <TableRow
                android:background="#FFEBEE">

                <TextView
                    android:text="151 - 200"
                    android:padding="8dp"
                    android:textColor="#333333"/>

                <TextView
                    android:text="Unhealthy"
                    android:textColor="#FB3527"
                    android:textStyle="bold"
                    android:padding="8dp" />

                <TextView
                    android:text="Everyone may feel effects"
                    android:padding="8dp"
                    android:textColor="#333333"/>
            </TableRow>

            <!-- Row 5 -->

            <TableRow
                android:background="#F3E5F5">

                <TextView
                    android:text="201 - 300"
                    android:padding="8dp"
                    android:textColor="#333333"/>

                <TextView
                    android:text="Very Unhealthy"
                    android:textColor="#9C27B0"
                    android:textStyle="bold"
                    android:padding="8dp" />

                <TextView
                    android:text="Serious health risks"
                    android:padding="8dp"
                    android:textColor="#333333"/>
            </TableRow>

            <!-- Row 6 -->

            <TableRow
                android:background="#ECEFF1">

                <TextView
                    android:text="301+"
                    android:padding="8dp"
                    android:textColor="#333333"/>

                <TextView
                    android:text="Hazardous"
                    android:textColor="#800000"
                    android:textStyle="bold"
                    android:padding="8dp" />

                <TextView
                    android:text="Emergency conditions"
                    android:padding="8dp"
                    android:textColor="#333333"/>
            </TableRow>

        </TableLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="20dp"
        android:background="@color/white">
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            android:padding="8dp"
            android:background="@color/white">

            <!-- Header Row -->

            <TableRow
                android:background="#FFFFFF">

                <TextView
                    android:text="AQI"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:padding="8dp" />

                <TextView
                    android:text="Recommendation"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:padding="8dp" />
            </TableRow>

            <!-- Row 1 -->

            <TableRow
                android:background="#E8F5E9">

                <TextView
                    android:text="0 - 50"
                    android:padding="8dp"
                    android:textColor="#333333"/>

                <TextView
                    android:text="Safe to enjoy outdoor activities."
                    android:padding="8dp"
                    android:textColor="#333333"/>
            </TableRow>

            <!-- Row 2 -->

            <TableRow
                android:background="#FFFDE7">

                <TextView
                    android:text="51 - 100"
                    android:padding="8dp"
                    android:textColor="#333333"/>

                <TextView
                    android:text="Sensitive people should reduce long outdoor stays."
                    android:padding="8dp"
                    android:textColor="#333333"/>
            </TableRow>

            <!-- Row 3 -->

            <TableRow
                android:background="#FFF3E0">

                <TextView
                    android:text="101 - 150"
                    android:padding="8dp"
                    android:textColor="#333333"/>
                <TextView
                    android:text="Limit outdoor activity if you're in a sensitive group."
                    android:padding="8dp"
                    android:textColor="#333333"/>
            </TableRow>

            <!-- Row 4 -->

            <TableRow
                android:background="#FFEBEE">

                <TextView
                    android:text="151 - 200"
                    android:padding="8dp"
                    android:textColor="#333333"/>

                <TextView
                    android:text="Avoid outdoor exercise; stay indoors if possible."
                    android:padding="8dp"
                    android:textColor="#333333"/>
            </TableRow>

            <!-- Row 5 -->

            <TableRow
                android:background="#F3E5F5">

                <TextView
                    android:text="201 - 300"
                    android:padding="8dp"
                    android:textColor="#333333"/>

                <TextView
                    android:text="Avoid outdoor exercise; stay indoors if possible."
                    android:padding="8dp"
                    android:textColor="#333333"/>
            </TableRow>

            <!-- Row 6 -->

            <TableRow
                android:background="#ECEFF1">

                <TextView
                    android:text="301+"
                    android:padding="8dp"
                    android:textColor="#333333"/>

                <TextView
                    android:text="Avoid all outdoor activities; follow government alerts."
                    android:padding="8dp"
                    android:textColor="#333333"/>
            </TableRow>

        </TableLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
